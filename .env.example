# ── Required ──────────────────────────────────────────────────────────────────
# (You can set these here OR enter them via the /setup page in the web UI)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
BOT_TOKEN=your_bot_token_here
OWNER_ID=123456789

# ── Optional ──────────────────────────────────────────────────────────────────
BOT_USERNAME=YourBotUsername
DB_NAME=waifu_bot
SESSION_SECRET=change_me_to_random_string

# ── Bot API connection (get key from bot's /api command) ──────────────────────
BOT_API_URL=https://your-bot.onrender.com
BOT_API_KEY=your_api_key_from_bot
