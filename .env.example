# Vercel: enter these in Project Settings > Environment Variables before deploy.
# The Flask app does not automatically load this file when run with python app.py.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=waifu_bot
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=YourBotUsername
OWNER_ID=123456789
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace_with_at_least_32_random_characters

# Optional bot HTTP API (needed only for features using that separate API).
BOT_API_URL=https://your-running-bot.example.com
BOT_API_KEY=your_api_key_from_bot

# Optional on persistent servers; Vercel enables secure cookies/proxy handling.
SESSION_COOKIE_SECURE=1
TRUST_PROXY=0
# Only for first-time /setup on persistent servers (not required on Vercel).
SETUP_KEY=replace_with_a_random_setup_key

# Do not set SITE_TITLE, SITE_SUBTITLE, or MAINTENANCE_MODE here if the owner
# should edit them in Admin. Environment values always override saved settings.
# VERCEL=1 is supplied automatically by Vercel; leave unset for local use.
